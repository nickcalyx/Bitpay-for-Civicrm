<?xml version="1.0"?>
<extension key="bitpay" type="module">
  <file>bitpay</file>
  <name>Bitpay payments for CiviCRM</name>
  <description>Accept payments through bitpay (https://bitpay.com/)</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Matthew Wire (MJW Consulting)</author>
    <email>mjw@mjwconsult.co.uk</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/nickcalyx/Bitpay-for-Civicrm</url>
    <url desc="Support">https://www.mjwconsult.co.uk</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
    <url desc="Documentation">https://docs.civicrm.org/bitpay/en/latest/</url>
  </urls>
  <releaseDate>2022-06-29</releaseDate>
  <version>1.1-dev</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.49</ver>
  </compatibility>
  <requires>
    <ext>mjwshared</ext>
  </requires>
  <civix>
    <namespace>CRM/Bitpay</namespace>
    <format>22.05.2</format>
  </civix>
  <mixins>
    <mixin>mgd-php@1.0.0</mixin>
  </mixins>
</extension>
